<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.superiormc.ultimatetweak</groupId>
  <artifactId>UltimateTweak</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <modules>
      <module>core</module>
      <module>paper</module>
      <module>spigot</module>
      <module>plugin</module>
  </modules>

  <name>UltimateTweak</name>

  <properties>
    <java.version>16</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <revision>1.3.2</revision>
    <name>UltimateTweak</name>
    <edition>free</edition>
  </properties>

  <profiles>
    <!--
      The premium sources live in a separate, private repository checked out into
      the ignored premium directory. This profile is deliberately inactive for normal/public
      builds, so a free build never resolves or packages premium bytecode.
    -->
    <profile>
      <id>premium</id>
      <properties>
        <edition>premium</edition>
      </properties>
      <modules>
        <module>premium</module>
      </modules>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <!-- Rebuild before shading: an existing shaded JAR contains dependency classes. -->
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <configuration>
          <transformers>
            <!-- Merge ServiceLoader descriptors when multiple expansion modules are shaded. -->
            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
          </transformers>
          <relocations>
            <relocation>
              <pattern>org.bstats</pattern>
              <shadedPattern>cn.superiormc.ultimatetweak.libs.bstats</shadedPattern>
            </relocation>
            <relocation>
              <pattern>org.json</pattern>
              <shadedPattern>cn.superiormc.ultimatetweak.libs.json</shadedPattern>
            </relocation>
            <relocation>
              <pattern>redempt.crunch</pattern>
              <shadedPattern>cn.superiormc.ultimatetweak.libs.crunch</shadedPattern>
            </relocation>
            <relocation>
              <pattern>cn.gtemc.itembridge</pattern>
              <shadedPattern>cn.superiormc.ultimatetweak.libs.itembridge</shadedPattern>
            </relocation>
          </relocations>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>

  <repositories>
      <repository>
          <id>spigotmc-repo</id>
          <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
          <snapshots>
